{
  "name": "jbrowse-plugin-graphgenomeviewer",
  "version": "0.2.0",
  "description": "JBrowse 2 graph genome (pangenome) view: rGFA reference-anchored layouts, the Bandage force-directed engine, and haplotype lanes read from a gbz-base database",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "jbrowse",
    "jbrowse2",
    "pangenome",
    "graph",
    "gfa",
    "bandage"
  ],
  "type": "module",
  "main": "dist/jbrowse-plugin-graphgenomeviewer.esm.js",
  "module": "dist/jbrowse-plugin-graphgenomeviewer.esm.js",
  "exports": "./dist/jbrowse-plugin-graphgenomeviewer.esm.js",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "format": "pnpm prettier --write .",
    "prebuild": "pnpm clean",
    "dev": "pnpm start",
    "start": "node esbuild.mjs --watch",
    "build": "NODE_ENV=production node esbuild.mjs",
    "build:wasm": "./scripts/build-wasm.sh",
    "test:wasm": "node scripts/smoke-wasm.mjs",
    "bench:layout": "node scripts/bench-layout.mjs",
    "layout-digest": "node scripts/layout-digest.mjs",
    "build:bundle": "NODE_ENV=production node esbuild.mjs",
    "betabuild": "bash scripts/betabuild.sh",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:all": "tsc",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "bench": "vitest bench --run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "prepack": "pnpm build",
    "preversion": "pnpm lint",
    "version": "node scripts/version.mjs",
    "postversion": "git push --follow-tags"
  },
  "private": true,
  "dependencies": {
    "@gmod/gbz-base": "^2.3.0",
    "@gmod/tabix": "^3.5.5",
    "@jbrowse/cigar-utils": "link:../../jbrowse-components/packages/cigar-utils",
    "@jbrowse/core": "link:../../jbrowse-components/packages/core",
    "@jbrowse/render-core": "link:../../jbrowse-components/packages/render-core",
    "@jbrowse/synteny-core": "link:../../jbrowse-components/packages/synteny-core"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@jbrowse/cli": "^4.3.0",
    "@jbrowse/mobx-state-tree": "^6.5.1",
    "@jbrowse/plugin-canvas": "link:../../jbrowse-components/plugins/canvas",
    "@jbrowse/plugin-linear-genome-view": "link:../../jbrowse-components/plugins/linear-genome-view",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@mui/system": "^9.2.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "mobx": "^7.0.3",
    "mobx-react": "^10.0.0",
    "prettier": "^3.9.6",
    "pretty-bytes": "^7.1.1",
    "puppeteer": "^25.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "^6.1.3",
    "rxjs": "^7.8.2",
    "serve": "^14.2.6",
    "tss-react": "^4.9.21",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "typescript7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
