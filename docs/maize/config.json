    }
  ],
  "assemblies": [
    {
      "name": "B73",
      "sequence": {
        "type": "ReferenceSequenceTrack",
        "trackId": "B73-refseq",
        "adapter": {
          "type": "BgzipFastaAdapter",
          "uri": "https://jbrowse.org/demos/maize_nam/chr8_450/B73.fa.gz"
        }
      }
    }
  ],
  "tracks": [
    {
      "type": "FeatureTrack",
      "trackId": "b73_genes",
      "name": "B73 v5 genes (Zm00001eb.1)",
      "assemblyNames": ["B73"],
      "adapter": {
        "type": "Gff3TabixAdapter",
        "uri": "https://jbrowse.org/demos/maize_nam/chr8_450/b73_genes.gff3.gz"
      }
    },
    {
      "type": "FeatureTrack",
      "trackId": "b73_te",
      "name": "B73 v5 TEs",
      "assemblyNames": ["B73"],
      "adapter": {
        "type": "Gff3TabixAdapter",
        "uri": "https://jbrowse.org/demos/maize_nam/chr8_450/b73_te.gff3.gz"
      }
    },
    {
      "type": "VariantTrack",
      "trackId": "maize_nam_variants",
      "name": "NAM founders vs B73 (vg deconstruct)",
      "assemblyNames": ["B73"],
      "adapter": {
        "type": "VcfTabixAdapter",
        "uri": "https://jbrowse.org/demos/maize_nam/chr8_450/maize_nam_chr8.nested.vcf.gz"
